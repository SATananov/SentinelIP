{
  "manifest_version": 3,
  "name": "SentinelIP Browser Sensor",
  "version": "0.1.0",
  "description": "Optional privacy-aware browser activity telemetry for SentinelIP.",
  "permissions": [
    "storage",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "SentinelIP Browser Sensor"
  }
}